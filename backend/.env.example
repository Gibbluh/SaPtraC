# Public HTTPS frontend URL used inside Driver and Unit QR codes.
# This must be reachable by the phone scanning the QR code.
QR_PUBLIC_BASE_URL=https://your-frontend-public-url.example
FRONTEND_ORIGIN=https://your-frontend-public-url.example

# Backend listener
HOST=0.0.0.0
PORT=3000

# Existing application settings should be copied from backend/.env.
